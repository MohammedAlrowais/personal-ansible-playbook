# ----------------------------------------------
# Pywal
# --------------------------------------------

~/.screenlayout/monitor.sh &

~/.config/qtile/scripts/wallpaper.sh init

# ----------------------------------------------
# Audio Configuration - Set GA106 as default
# ----------------------------------------------
sleep 1  # Wait for PipeWire to be ready

# Find and set GA106 as default sink
DEFAULT_SINK=$(pactl list sinks short | grep -i "GA106\|nvidia" | head -1 | awk '{print $2}')
if [ -n "$DEFAULT_SINK" ]; then
    pactl set-default-sink "$DEFAULT_SINK"
fi

# ----------------------------------------------
# Screenshot tool
# ----------------------------------------------
flameshot &

# Network manager (if not using gnome/kde)
nm-applet &

# Volume control in system tray
pasystray &

# Clipboard manager
copyq &

# Notification daemon
dunst &

# Compositor for transparency and effects
picom &

# ----------------------------------------------
# Disable screen blanking and DPMS (no sleep on idle)
# ----------------------------------------------
xset s off          # Disable screen saver
xset -dpms          # Disable DPMS (Energy Star) power management
xset s noblank      # Don't blank the screen

# ----------------------------------------------
# Fallback: if keyboard firmware has swapped Win/Alt,
# swap them back at the X11 layer so mod4 (Super) works.
# ----------------------------------------------
if [ "$(xmodmap -pke | awk '/^keycode 133 = / {print $4}')" = "Alt_L" ]; then
    setxkbmap -option altwin:swap_lalt_lwin
fi

